# Google Sheets Configuration
# Option 1: Use Sheet ID (simpler, no API key needed)
# Get from URL: https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
NEXT_PUBLIC_GOOGLE_SHEETS_ID=your_google_sheet_id_here

# Option 2: Use custom published URL (optional, overrides Sheet ID)
# Go to File > Share > Publish to web > Select sheet > Publish as CSV
# NEXT_PUBLIC_GOOGLE_SHEETS_PUBLISHED_URL=https://docs.google.com/spreadsheets/d/e/YOUR_PUBLISHED_ID/pub?output=csv

# Optional: Supabase (for future features)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
